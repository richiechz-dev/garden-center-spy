DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_db

# HomeDepot API
# Endpoints JSON internos de las tiendas (no son APIs públicas oficiales).
# Descúbrelos con DevTools (F12) > Network > Fetch/XHR al navegar un listado
# de plantas en la web de cada tienda, y pégalos aquí.
HOME_DEPOT_API_URL=

# IKEA API
IKEA_API_URL=
# IKEA: código de categoría (10779 = Plantas naturales)
IKEA_CATEGORY=10779

POSTGRES_USER=name
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name